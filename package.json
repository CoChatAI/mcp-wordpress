{
  "name": "@cochatai/mcp-wordpress",
  "version": "1.1.0",
  "description": "A Model Context Protocol server for the WordPress REST API — full CRUD for posts, pages, media, users, categories, tags, and more.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-wordpress": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "smoke:media": "node scripts/smoke-media.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "undici": "6.28.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "wordpress",
    "mcp",
    "model-context-protocol",
    "ai",
    "rest-api"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CoChatAI/mcp-wordpress.git"
  }
}
